# NextAuth — OTP (Resend + Credentials, no database)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Delta Portal <noreply@yourdomain.com>"
# Corporate email domain lock (without the @ symbol) — leave empty in demo mode
ALLOWED_EMAIL_DOMAIN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini
# Used by both @google/genai (content generation) and @ai-sdk/google (invoice extraction)
GEMINI_API_KEY=your-gemini-api-key

# Relevance AI — Press Release Agent
# Region base URL: https://api-<region>.stack.tryrelevance.com/latest
RELEVANCE_AI_REGION_BASE_URL=https://api-<region>.stack.tryrelevance.com/latest
RELEVANCE_AI_AGENT_ID=your-agent-id
# API key format: <project_id>:<api_key>
RELEVANCE_AI_API_KEY=your-project-id:your-api-key

# Integrations — env var fallback (can also be set via the Integrations UI in the app)
# Teams: use a Workflow webhook URL (Teams channel → Workflows → "Post when webhook received")
TEAMS_WEBHOOK_URL=
# Basecamp: use a Chatbot webhook URL (Basecamp project → Campfire → "Add a chatbot")
BASECAMP_WEBHOOK_URL=

# Basecamp 3 REST API — Todo Creation
BASECAMP_CLIENT_ID=your-client-id
BASECAMP_CLIENT_SECRET=your-client-secret
BASECAMP_ACCOUNT_ID=your-account-id
BASECAMP_PROJECT_ID=your-project-id
BASECAMP_TODOLIST_ID=your-todolist-id
BASECAMP_ASSIGNEE_ID=your-assignee-id
BASECAMP_BILYANA_ID=your-bilyana-user-id
# OAuth refresh token (https://launchpad.37signals.com/authorization)
BASECAMP_REFRESH_TOKEN=your-refresh-token
# Fallback static access token if refresh is unavailable
BASECAMP_ACCESS_TOKEN=your-access-token
